rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de posts
    match /posts/{post} {
      allow read: if true; // Cualquier persona puede leer posts
      allow create, update, delete: if request.auth != null; // Solo usuarios logueados pueden escribir
    }
    
    // Reglas para la colección de usuarios
    match /usuarios/{userId} {
      allow read: if true; // Permitir ver perfiles
      allow write: if request.auth != null && request.auth.uid == userId; // Solo el propio usuario puede editar su perfil
    }

    // Regla por defecto para cualquier otro documento
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
